# Supabase Configuration
# Get these from your Supabase project settings
# REPLACE WITH YOUR ACTUAL VALUES - DO NOT USE THESE EXAMPLES
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Application URL (for production)
# VITE_APP_URL=https://your-domain.com

# Required: Google Maps API Key (for salon discovery features)
# Get this from Google Cloud Console - enable Maps JavaScript API and Places API
# REPLACE WITH YOUR ACTUAL API KEY - DO NOT USE THIS PLACEHOLDER
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-placeholder

# Optional: Analytics (if you want to add analytics)  
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Sentry for error tracking
# VITE_SENTRY_DSN=https://your-sentry-dsn

# Production Security Configuration
# REQUIRED for production deployment - no defaults for security

# Redis Password (required for production)
REDIS_PASSWORD=your-secure-redis-password-here

# Grafana Admin Password (required for monitoring access)
GRAFANA_PASSWORD=your-secure-grafana-password-here

# CORS Origin for API access (set to your production domain)
CORS_ORIGIN=https://your-production-domain.com