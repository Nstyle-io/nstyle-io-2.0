# Local Development Environment
# Copy this file to .env.local and add your actual values
# .env.local is automatically ignored by git for security

# WARNING: Never commit real API keys to version control!
# These environment variables will be bundled into your frontend build
# Only use development/test keys, never production keys in frontend

VITE_SUPABASE_URL=your-development-supabase-url
VITE_SUPABASE_ANON_KEY=your-development-supabase-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-development-google-maps-api-key

# Note: Variables prefixed with VITE_ are exposed to the frontend
# Never put sensitive server-side secrets in VITE_ variables